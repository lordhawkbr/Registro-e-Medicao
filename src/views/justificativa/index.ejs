<div class="page-header">
  <h1>Minhas Justificativas</h1>
  <a href="/painel?tab=justificativas" class="btn">Voltar ao painel</a>
</div>

<% if (justificativas.length === 0) { %>
  <p class="muted">Nenhuma justificativa enviada.</p>
<% } %>

<% justificativas.forEach(j => { %>
  <article class="plantao-tile">
    <div class="plantao-tile-top">
      <div>
        <strong>#<%= j.IDJUSTIFICATIVA %></strong>
        <p class="muted">Plantão #<%= j.IDPLANTAO %> · <%= new Date(j.DATA).toLocaleDateString('pt-BR') %></p>
        <span class="tag tag-<%= j.TIPO_CLASSE %>"><%= j.TIPO_LABEL || j.TIPOAUSENCIA %></span>
      </div>
      <span class="badge badge-<%= (j.STATUS_CLASSE || j.STATUSAPROVACAO || '').toLowerCase() %>"><%= j.STATUS_LABEL || j.STATUSAPROVACAO %></span>
    </div>
  </article>
<% }) %>
