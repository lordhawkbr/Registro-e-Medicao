<div class="medico-shell">
  <header class="medico-header">
    <div>
      <p class="medico-eyebrow">Área do médico</p>
      <h1><%= nome %></h1>
    </div>
    <form method="post" action="/logout"><button class="btn btn-ghost" type="submit">Sair</button></form>
  </header>

  <nav class="medico-tabs medico-tabs-3">
    <a class="medico-tab <%= tab === 'plantoes' ? 'is-active' : '' %>" href="/painel?tab=plantoes&mes=<%= calendario.mesAtual %>&dia=<%= diaSelecionado %>">Calendário</a>
    <a class="medico-tab <%= tab === 'abertos' ? 'is-active' : '' %>" href="/painel?tab=abertos">
      Abertos<% if (plantoesAbertos.length) { %> (<%= plantoesAbertos.length %>)<% } %>
    </a>
    <a class="medico-tab <%= tab === 'justificativas' ? 'is-active' : '' %>" href="/painel?tab=justificativas">Justificativas</a>
  </nav>

  <% if (tab === "plantoes") { %>

    <section class="calendario-card" id="calendarioCard">
      <div class="calendario-nav">
        <button type="button" class="btn btn-ghost btn-sm" id="btnToggleCalendario" aria-expanded="true">Ocultar calendário</button>
        <div class="calendario-nav-meses" id="calendarioNavMeses">
          <a class="btn btn-ghost" href="/painel?tab=plantoes&mes=<%= calendario.mesAnterior %>&dia=<%= diaSelecionado %>">‹</a>
          <strong class="calendario-mes"><%= calendario.mesLabel %></strong>
          <a class="btn btn-ghost" href="/painel?tab=plantoes&mes=<%= calendario.mesProximo %>&dia=<%= diaSelecionado %>">›</a>
        </div>
      </div>

      <div class="calendario-grid" id="calendarioGrid">
        <% calendario.diasSemana.forEach(d => { %>
          <div class="calendario-dow"><%= d %></div>
        <% }) %>
        <% calendario.dias.forEach(dia => { %>
          <% if (dia.vazio) { %>
            <div class="calendario-cell is-empty"></div>
          <% } else { %>
            <a
              class="calendario-cell <%= dia.hoje ? 'is-today' : '' %> <%= dia.temPlantao ? 'has-shift' : '' %> <%= dia.chave === diaSelecionado ? 'is-selected' : '' %>"
              href="/painel?tab=plantoes&mes=<%= calendario.mesAtual %>&dia=<%= dia.chave %>"
            >
              <span class="calendario-daynum"><%= dia.dia %></span>
              <% if (dia.temPlantao) { %>
                <span class="calendario-dot" title="<%= dia.qtd %> plantão(ões)"></span>
              <% } %>
            </a>
          <% } %>
        <% }) %>
      </div>
    </section>

    <section class="dia-detalhe">
      <h2>Dia <%= diaSelecionado.split('-').reverse().join('/') %></h2>
      <% if (plantoesDoDia.length > 1) { %>
        <p class="muted"><%= plantoesDoDia.length %> plantões neste dia</p>
      <% } %>

      <% if (plantoesDoDia.length === 0) { %>
        <p class="muted">Nenhum plantão neste dia.</p>
      <% } %>

      <div class="<%= plantoesDoDia.length > 1 ? 'plantao-lista-compacta' : '' %>">
        <% plantoesDoDia.forEach(({ plantao, registros, avaliacao }) => { %>
          <%- include('../partials/plantaoTile', { plantao, registros, avaliacao, compacto: plantoesDoDia.length > 1 }) %>
        <% }) %>
      </div>
    </section>

    <script>
      (function () {
        const card = document.getElementById("calendarioCard");
        const grid = document.getElementById("calendarioGrid");
        const navMeses = document.getElementById("calendarioNavMeses");
        const btn = document.getElementById("btnToggleCalendario");
        if (!card || !btn) return;

        const KEY = "escala.calendarioVisivel";
        function aplicar(visivel) {
          grid.style.display = visivel ? "grid" : "none";
          navMeses.style.display = visivel ? "flex" : "none";
          card.classList.toggle("is-collapsed", !visivel);
          btn.setAttribute("aria-expanded", visivel ? "true" : "false");
          btn.textContent = visivel ? "Ocultar calendário" : "Mostrar calendário";
          try { localStorage.setItem(KEY, visivel ? "1" : "0"); } catch (e) {}
        }

        let visivel = true;
        try { visivel = localStorage.getItem(KEY) !== "0"; } catch (e) {}
        aplicar(visivel);
        btn.addEventListener("click", () => aplicar(!(btn.getAttribute("aria-expanded") === "true")));
      })();
    </script>

  <% } else if (tab === "abertos") { %>

    <section class="dia-detalhe">
      <h2>Plantões em aberto</h2>
      <p class="muted">Aberto ou em andamento — atalho sem usar o calendário.</p>

      <% if (plantoesAbertos.length === 0) { %>
        <p class="muted">Nenhum plantão em aberto.</p>
      <% } %>

      <div class="<%= plantoesAbertos.length > 1 ? 'plantao-lista-compacta' : '' %>">
        <% plantoesAbertos.forEach(({ plantao, registros, avaliacao }) => { %>
          <%- include('../partials/plantaoTile', { plantao, registros, avaliacao, compacto: plantoesAbertos.length > 1 }) %>
        <% }) %>
      </div>
    </section>

  <% } else { %>

    <section class="dia-detalhe">
      <h2>Minhas justificativas</h2>
      <p class="muted">Somente plantões da sua escala.</p>

      <% if (justificativas.length === 0) { %>
        <p class="muted">Nenhuma justificativa enviada.</p>
      <% } %>

      <% justificativas.forEach(j => { %>
        <article class="plantao-tile">
          <div class="plantao-tile-top">
            <div>
              <strong>#<%= j.IDJUSTIFICATIVA %></strong>
              <p class="muted">Plantão #<%= j.IDPLANTAO %> · <%= new Date(j.DATA).toLocaleDateString('pt-BR') %></p>
              <p><%= j.TIPOAUSENCIA %></p>
            </div>
            <span class="badge badge-<%= j.STATUSAPROVACAO.toLowerCase() %>"><%= j.STATUSAPROVACAO %></span>
          </div>
          <% if (j.MOTIVO) { %>
            <p class="justificativa-motivo"><%= j.MOTIVO %></p>
          <% } %>
        </article>
      <% }) %>
    </section>

  <% } %>
</div>
