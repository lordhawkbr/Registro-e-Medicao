<%
  const proximoTipo = avaliacao && avaliacao.proximoTipo ? avaliacao.proximoTipo : null;
  const concluido = plantao.STATUS === "CANCELADO"
    || plantao.STATUS === "CONCLUIDO"
    || (avaliacao && avaliacao.concluidoParaMedico);
  const horaProxima = proximoTipo === "SAIDA"
    ? (plantao.HORAFIM_INPUT || "")
    : (plantao.HORAINICIO_INPUT || "");
  const tituloAcao = concluido
    ? null
    : (proximoTipo && horaProxima ? `${proximoTipo} às ${horaProxima}` : null);
  const especialidade = plantao.ESPECIALIDADE_NOME || plantao.IDESPECIALIDADE || "";
%>
<article class="plantao-tile <%= typeof compacto !== 'undefined' && compacto ? 'plantao-tile-compact' : '' %>">
  <div class="plantao-tile-top">
    <div>
      <h3 class="plantao-titulo">
        Plantão #<%= plantao.IDPLANTAO %><% if (tituloAcao) { %> —
        <span class="plantao-titulo-hora"><%= tituloAcao %></span><% } %>
      </h3>
      <p class="plantao-horario"><%= plantao.HORARIO_FORMATADO %></p>
      <p class="plantao-meta">
        <strong>Filial <%= plantao.CODFILIAL %></strong>
        <% if (especialidade) { %>
          · <strong>Especialidade <%= especialidade %></strong>
        <% } else if (plantao.SETOR_NOME) { %>
          · <%= plantao.SETOR_NOME %>
        <% } %>
      </p>
      <% if (!(typeof compacto !== 'undefined' && compacto) && plantao.TIPO_NOME) { %>
        <p class="muted"><%= plantao.TIPO_NOME %></p>
      <% } %>
    </div>
    <div class="plantao-badges">
      <span class="badge badge-<%= plantao.CONCLUSAO.classe %>"><%= plantao.CONCLUSAO.label %></span>
    </div>
  </div>

  <% if (registros.length) { %>
    <ul class="lista-registros <%= typeof compacto !== 'undefined' && compacto ? 'lista-registros-compact' : '' %>">
      <% registros.forEach(r => { %>
        <li><%= r.TIPO %> às <%= r.HORABATIDA_FMT || r.HORABATIDA %></li>
      <% }) %>
    </ul>
  <% } %>

  <div class="plantao-actions <%= typeof compacto !== 'undefined' && compacto ? 'plantao-actions-compact' : '' %>">
    <% if (concluido) { %>
      <span class="muted">Sem ações disponíveis</span>
    <% } else if (avaliacao.podeIniciar) { %>
      <form method="post" action="/registro-acesso/<%= plantao.IDPLANTAO %>/bater">
        <button type="submit" class="btn btn-primary <%= typeof compacto !== 'undefined' && compacto ? '' : 'btn-block' %>">
          Registrar <%= avaliacao.proximoTipo %>
        </button>
      </form>
    <% } else { %>
      <button type="button" class="btn <%= typeof compacto !== 'undefined' && compacto ? '' : 'btn-block' %>" disabled>
        <% if (avaliacao.antesDaJanela) { %>
          Ainda não liberado (~<%= avaliacao.diffMin %> min)
        <% } else if (avaliacao.depoisDaJanela) { %>
          Fora da janela (+<%= avaliacao.diffMin %> min)
        <% } else { %>
          Indisponível
        <% } %>
      </button>
      <% if (avaliacao.podeJustificar) { %>
        <a class="btn btn-warn <%= typeof compacto !== 'undefined' && compacto ? '' : 'btn-block' %>" href="/justificativa/novo?idPlantao=<%= plantao.IDPLANTAO %>">Justificar</a>
      <% } %>
    <% } %>
  </div>
</article>
