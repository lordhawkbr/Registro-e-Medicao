<div class="page-header">
  <h1>Registro de Acesso</h1>
  <form method="post" action="/logout"><button class="btn">Sair</button></form>
</div>

<% if (typeof erro !== "undefined" && erro === "fora_da_janela") { %>
  <div class="alert alert-danger">
    Fora do horário permitido para registrar este plantão (tolerância de <%= tolerancia %> minutos).
    Se você realmente cumpriu o plantão, abra uma <a href="/justificativa/novo?idPlantao=<%= typeof plantaoErro !== 'undefined' ? plantaoErro : '' %>">Justificativa de Ausência de Registro</a>.
  </div>
<% } %>

<% if (plantoes.length === 0) { %>
  <p>Nenhum plantão seu está ativo hoje.</p>
<% } %>

<% plantoes.forEach(({ plantao, registros, avaliacao }) => { %>
  <div class="card-plantao">
    <div>
      <strong>Plantão #<%= plantao.IDPLANTAO %></strong> —
      <%= plantao.HORAINICIO %> às <%= plantao.HORAFIM %> —
      Filial <%= plantao.CODFILIAL %> / Setor <%= plantao.CODCCUSTO %>
      <span class="badge badge-<%= plantao.STATUS.toLowerCase() %>"><%= plantao.STATUS %></span>
    </div>

    <ul class="lista-registros">
      <% registros.forEach(r => { %>
        <li><%= r.TIPO %> às <%= r.HORABATIDA %></li>
      <% }) %>
    </ul>

    <% if (plantao.STATUS !== "CONCLUIDO") { %>
      <form method="post" action="/registro-acesso/<%= plantao.IDPLANTAO %>/bater">
        <% if (avaliacao.dentroDaJanela) { %>
          <button type="submit" class="btn btn-primary">
            Registrar <%= avaliacao.proximoTipo %>
          </button>
        <% } else { %>
          <button type="button" class="btn" disabled>
            <%= avaliacao.proximoTipo %> fora da janela (<%= avaliacao.diffMin %>min de diferença)
          </button>
          <a class="btn" href="/justificativa/novo?idPlantao=<%= plantao.IDPLANTAO %>">Abrir justificativa</a>
        <% } %>
      </form>
    <% } %>
  </div>
<% }) %>
