<%
  const qsBase = [];
  if (filtros.codFilial) qsBase.push("codFilial=" + encodeURIComponent(filtros.codFilial));
  if (filtros.categoria) qsBase.push("categoria=" + encodeURIComponent(filtros.categoria));
  if (filtros.statusCal) qsBase.push("statusCal=" + encodeURIComponent(filtros.statusCal));
  const qsFiltros = qsBase.length ? "&" + qsBase.join("&") : "";
  const hojeMes = calendario.hojeChave.slice(0, 7);
%>
<div class="page-calendario">
  <div class="page-header">
    <h1>Calendário</h1>
    <div class="page-header-actions">
      <a class="btn btn-primary" href="/escala/novo?origem=calendario">+ Novo plantão</a>
      <form method="post" action="/logout"><button class="btn">Sair</button></form>
    </div>
  </div>

  <div class="cal-layout">
    <aside class="cal-sidebar" aria-label="Filtros e resumo">
      <form method="get" action="/escala/calendario" class="cal-panel cal-filtros" id="formFiltrosCalendario">
        <input type="hidden" name="mes" value="<%= filtros.mes %>">
        <h2 class="cal-panel-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Filtros
        </h2>

        <label class="cal-filtro-label">
          <span class="sr-only">Filial</span>
          <select name="codFilial" onchange="this.form.submit()">
            <option value="">Todas as Filiais</option>
            <% filiais.forEach(f => { %>
              <option value="<%= f.codFilial %>" <%= String(filtros.codFilial) === String(f.codFilial) ? "selected" : "" %>>
                <%= f.nome %>
              </option>
            <% }) %>
          </select>
        </label>

        <label class="cal-filtro-label">
          <span class="sr-only">Categoria</span>
          <select name="categoria" onchange="this.form.submit()" <%= categorias.length ? "" : "disabled" %>>
            <% if (!categorias.length) { %>
              <option value="">Sem categorias neste mês</option>
            <% } else { %>
              <option value="">Todas as categorias</option>
              <% categorias.forEach(c => { %>
                <option value="<%= c.codigo %>" <%= String(filtros.categoria) === String(c.codigo) ? "selected" : "" %>>
                  <%= c.nome %>
                </option>
              <% }) %>
            <% } %>
          </select>
        </label>

        <label class="cal-filtro-label">
          <span class="sr-only">Status</span>
          <select name="statusCal" onchange="this.form.submit()">
            <option value="">Todos os Status</option>
            <% statusLegenda.forEach(s => { %>
              <option value="<%= s.key %>" <%= filtros.statusCal === s.key ? "selected" : "" %>>
                <%= s.label %>
              </option>
            <% }) %>
          </select>
        </label>
      </form>

      <section class="cal-panel cal-stats">
        <h2 class="cal-panel-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V5M4 19h16M8 15v4M12 11v8M16 7v12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Estatísticas
        </h2>
        <dl class="cal-stats-list">
          <div><dt>Total de Eventos</dt><dd><%= stats.total %></dd></div>
          <div><dt>Este Mês</dt><dd><%= stats.esteMes %></dd></div>
          <div><dt>Pendentes</dt><dd><%= stats.pendentes %></dd></div>
          <div><dt>Concluídos</dt><dd><%= stats.concluidos %></dd></div>
        </dl>
      </section>

      <section class="cal-panel cal-legenda">
        <h2 class="cal-panel-title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 7h10v10H7zM4 4h3v3H4zM17 4h3v3h-3zM4 17h3v3H4zM17 17h3v3h-3z" stroke="currentColor" stroke-width="1.6"/></svg>
          Legenda por Status
        </h2>
        <ul class="cal-legenda-list">
          <% statusLegenda.forEach(s => { %>
            <li>
              <span class="cal-legenda-swatch <%= s.classe %>" aria-hidden="true"></span>
              <%= s.label %>
            </li>
          <% }) %>
        </ul>
      </section>
    </aside>

    <section class="cal-main" aria-label="Grade do mês">
      <div class="cal-toolbar">
        <div class="cal-toolbar-nav">
          <a class="btn btn-ghost cal-nav-btn" href="/escala/calendario?mes=<%= calendario.mesAnterior %><%= qsFiltros %>" title="Mês anterior" aria-label="Mês anterior">‹</a>
          <a class="btn btn-ghost cal-nav-btn" href="/escala/calendario?mes=<%= calendario.mesProximo %><%= qsFiltros %>" title="Próximo mês" aria-label="Próximo mês">›</a>
          <a class="btn btn-ghost cal-today-btn" href="/escala/calendario?mes=<%= hojeMes %><%= qsFiltros %>">today</a>
        </div>
        <h2 class="cal-month-title"><%= calendario.mesLabel %></h2>
        <div class="cal-toolbar-view">
          <span class="btn btn-ghost cal-view-btn is-active">month</span>
        </div>
      </div>

      <div class="cal-grid" role="grid" aria-label="<%= calendario.mesLabel %>">
        <% calendario.diasSemana.forEach(d => { %>
          <div class="cal-dow" role="columnheader"><%= d %></div>
        <% }) %>

        <% calendario.dias.forEach(dia => { %>
          <% if (dia.vazio) { %>
            <div class="cal-day is-empty" role="gridcell"></div>
          <% } else { %>
            <div
              class="cal-day <%= dia.hoje ? 'is-today' : '' %> <%= dia.temPlantao ? 'has-events' : '' %>"
              role="gridcell"
              data-date="<%= dia.chave %>"
              tabindex="0"
              title="Clique para cadastrar plantão em <%= dia.chave.split('-').reverse().join('/') %>"
            >
              <div class="cal-day-head">
                <span class="cal-daynum"><%= dia.dia %></span>
                <a
                  class="cal-day-add"
                  href="/escala/novo?data=<%= dia.chave %>&origem=calendario"
                  title="Novo plantão neste dia"
                  aria-label="Novo plantão em <%= dia.chave %>"
                  onclick="event.stopPropagation()"
                >+</a>
              </div>
              <div class="cal-day-events">
                <% dia.eventos.forEach(ev => { %>
                  <button
                    type="button"
                    class="cal-event <%= ev.STATUS_CAL.classe %>"
                    data-plantao-id="<%= ev.IDPLANTAO %>"
                    data-date="<%= dia.chave %>"
                    title="<%= ev.TITULO_CAL %> · <%= ev.STATUS_CAL.label %>"
                    onclick="event.stopPropagation(); abrirDetalhePlantao(<%= ev.IDPLANTAO %>, '<%= dia.chave %>')"
                  >
                    <span class="cal-event-dot" aria-hidden="true"></span>
                    <span class="cal-event-text"><%= ev.TITULO_CAL %></span>
                  </button>
                <% }) %>
                <% if (dia.ocultos > 0) { %>
                  <button
                    type="button"
                    class="cal-more"
                    data-date="<%= dia.chave %>"
                    data-qtd="<%= dia.qtd %>"
                    onclick="event.stopPropagation(); abrirDiaCompleto(this)"
                  >+<%= dia.ocultos %> more</button>
                <% } %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    </section>
  </div>
</div>

<dialog class="cal-day-dialog" id="dlgDiaCompleto">
  <form method="dialog" class="cal-day-dialog-inner">
    <header class="cal-day-dialog-head">
      <h3 id="dlgDiaTitulo">Plantões do dia</h3>
      <button type="submit" class="btn btn-ghost" value="cancel" aria-label="Fechar">✕</button>
    </header>
    <div class="cal-day-dialog-body" id="dlgDiaLista"></div>
    <footer class="cal-day-dialog-foot">
      <a class="btn btn-primary" id="dlgDiaNovo" href="#">+ Novo plantão neste dia</a>
    </footer>
  </form>
</dialog>

<dialog class="cal-day-dialog plantao-detalhe-dialog" id="dlgPlantaoDetalhe">
  <div class="cal-day-dialog-inner">
    <header class="cal-day-dialog-head">
      <h3 id="dlgPlantaoTitulo">Detalhes do plantão</h3>
      <button type="button" class="btn btn-ghost" id="dlgPlantaoFechar" aria-label="Fechar">✕</button>
    </header>
    <div class="cal-day-dialog-body" id="dlgPlantaoCorpo"></div>
    <footer class="cal-day-dialog-foot" id="dlgPlantaoAcoes"></footer>
  </div>
</dialog>

<script>
(function () {
  const porDia = <%- JSON.stringify(porDiaJson || {}) %>;
  const dlg = document.getElementById("dlgDiaCompleto");
  const lista = document.getElementById("dlgDiaLista");
  const titulo = document.getElementById("dlgDiaTitulo");
  const linkNovo = document.getElementById("dlgDiaNovo");
  const dlgDetalhe = document.getElementById("dlgPlantaoDetalhe");
  const detalheTitulo = document.getElementById("dlgPlantaoTitulo");
  const detalheCorpo = document.getElementById("dlgPlantaoCorpo");
  const detalheAcoes = document.getElementById("dlgPlantaoAcoes");
  const detalheFechar = document.getElementById("dlgPlantaoFechar");

  function escapar(texto) {
    return String(texto == null ? "" : texto)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function buscarEvento(idPlantao, data) {
    const id = Number(idPlantao);
    if (data && porDia[data]) {
      const achou = porDia[data].find(ev => Number(ev.IDPLANTAO) === id);
      if (achou) return achou;
    }
    for (const listaDia of Object.values(porDia)) {
      const achou = (listaDia || []).find(ev => Number(ev.IDPLANTAO) === id);
      if (achou) return achou;
    }
    return null;
  }

  function irNovo(data) {
    window.location.href = "/escala/novo?data=" + encodeURIComponent(data) + "&origem=calendario";
  }

  window.abrirDetalhePlantao = function (idPlantao, data) {
    const ev = buscarEvento(idPlantao, data);
    if (!ev || !dlgDetalhe) return;

    detalheTitulo.textContent = "Plantão #" + ev.IDPLANTAO;
    const conclusaoLabel = (ev.CONCLUSAO && ev.CONCLUSAO.label)
      || (ev.STATUS_CAL && ev.STATUS_CAL.label)
      || "—";
    const conclusaoClasse = (ev.CONCLUSAO && ev.CONCLUSAO.classe) || "cancelado";

    let medicosHtml = "";
    if (ev.MEDICOS && ev.MEDICOS.length) {
      medicosHtml = ev.MEDICOS.map(m => {
        const tag = m.conclusao
          ? '<span class="tag tag-' + escapar(m.conclusao.classe) + '">' + escapar(m.conclusao.label) + "</span>"
          : "";
        return '<div class="cell-medico"><div class="cell-nome">' + escapar(m.nome || m.crm) +
          '</div><div class="muted">' + escapar(m.crm || "") + "</div>" + tag + "</div>";
      }).join("");
    } else {
      medicosHtml = "<div>" + escapar(ev.MEDICO || "—") + "</div>";
    }

    detalheCorpo.innerHTML =
      '<div class="plantao-modal-grid">' +
        '<div><span class="muted">Data</span><strong>' + escapar(ev.DATA_FMT || "—") + "</strong></div>" +
        '<div><span class="muted">Horário</span><strong>' + escapar(ev.HORARIO || "—") + "</strong></div>" +
        '<div><span class="muted">Filial</span><strong>' + escapar(ev.FILIAL || "—") + "</strong></div>" +
        '<div><span class="muted">Setor</span><strong>' + escapar(ev.SETOR || "—") + "</strong></div>" +
        (ev.ESPECIALIDADE
          ? '<div class="plantao-modal-span"><span class="muted">Especialidade</span><strong>' + escapar(ev.ESPECIALIDADE) + "</strong></div>"
          : "") +
        '<div class="plantao-modal-span"><span class="muted">Conclusão</span>' +
          '<span class="tag tag-' + escapar(conclusaoClasse) + '">' + escapar(conclusaoLabel) + "</span></div>" +
        '<div class="plantao-modal-span"><span class="muted">Médico(s)</span>' + medicosHtml + "</div>" +
      "</div>";

    let acoes = "";
    if (ev.PODE_EDITAR) {
      acoes += '<a class="btn btn-primary" href="/escala/' + ev.IDPLANTAO + '/editar">Editar plantão</a>';
    }
    acoes += '<button type="button" class="btn" id="dlgPlantaoFechar2">Fechar</button>';
    detalheAcoes.innerHTML = acoes;

    const fechar2 = document.getElementById("dlgPlantaoFechar2");
    if (fechar2) fechar2.addEventListener("click", () => dlgDetalhe.close());
    if (typeof dlgDetalhe.showModal === "function") dlgDetalhe.showModal();
  };

  if (detalheFechar) {
    detalheFechar.addEventListener("click", () => dlgDetalhe.close());
  }
  if (dlgDetalhe) {
    dlgDetalhe.addEventListener("click", (e) => {
      if (e.target === dlgDetalhe) dlgDetalhe.close();
    });
  }

  document.querySelectorAll(".cal-day:not(.is-empty)").forEach(cell => {
    cell.addEventListener("click", (e) => {
      if (e.target.closest("a, button")) return;
      const data = cell.getAttribute("data-date");
      if (data) irNovo(data);
    });
    cell.addEventListener("keydown", (e) => {
      if (e.key !== "Enter" && e.key !== " ") return;
      if (e.target !== cell) return;
      e.preventDefault();
      const data = cell.getAttribute("data-date");
      if (data) irNovo(data);
    });
  });

  window.abrirDiaCompleto = function (btn) {
    const data = btn.getAttribute("data-date");
    const eventos = porDia[data] || [];
    const [y, m, d] = data.split("-");
    titulo.textContent = "Plantões · " + d + "/" + m + "/" + y;
    linkNovo.href = "/escala/novo?data=" + encodeURIComponent(data) + "&origem=calendario";
    lista.innerHTML = eventos.map(ev => {
      const classe = (ev.STATUS_CAL && ev.STATUS_CAL.classe) || "cal-evt-pendente";
      const label = (ev.STATUS_CAL && ev.STATUS_CAL.label) || "";
      const text = ev.TITULO_CAL || ("Plantão #" + ev.IDPLANTAO);
      return '<button type="button" class="cal-event cal-event-full ' + classe + '" ' +
        'onclick="abrirDetalhePlantao(' + ev.IDPLANTAO + ', \'' + data + '\')">' +
        '<span class="cal-event-text">' + text + '</span>' +
        '<span class="cal-event-status">' + label + "</span></button>";
    }).join("") || '<p class="muted">Nenhum plantão.</p>';
    if (typeof dlg.showModal === "function") dlg.showModal();
  };
})();
</script>
