<h1>
  <%= plantao && plantao.IDPLANTAO ? "Editar plantão" : "Novo plantão" %>
</h1>

<% if (erro) { %>
  <div class="alert alert-danger">
    <%= erro %>
  </div>
<% } %>

<%
  const dataVal = plantao ? (plantao.DATA_INPUT || plantao.data || "") : "";
  const horaIniVal = plantao ? (plantao.HORAINICIO_INPUT || plantao.horaInicio || "") : "";
  const horaFimVal = plantao ? (plantao.HORAFIM_INPUT || plantao.horaFim || "") : "";
  const crmAtual = plantao ? (plantao.CRM_ESCALADO || plantao.crmEscalado || "") : "";
  const ufAtual = plantao ? (plantao.ufCrm || "") : "";
  const especialidadeAtual = plantao ? (plantao.IDESPECIALIDADE || plantao.idEspecialidade || plantao.especialidade || "") : "";
%>

<form id="formEscala" method="post"
  action="<%= plantao && plantao.IDPLANTAO ? `/escala/${plantao.IDPLANTAO}?_method=PUT` : '/escala' %>"
  class="form-grid"
>
  <input type="hidden" name="idEspecialidade" id="inpIdEspecialidade" required value="<%= especialidadeAtual %>">
  <input type="hidden" name="especialidade" id="inpEspecialidade" value="<%= especialidadeAtual %>">
  <input type="hidden" name="crmEscalado" id="inpCrmEscalado" required value="<%= crmAtual %>">
  <input type="hidden" name="ufCrm" id="inpUfCrm" value="<%= ufAtual %>">

  <label>
    Filial
    <select name="codFilial" id="selFilial" required>
      <option value="">Selecione a filial</option>
      <% filiais.forEach(f=> { %>
        <option value="<%= f.codFilial %>" <%= plantao && String(plantao.CODFILIAL || plantao.codFilial) === String(f.codFilial) ? "selected" : "" %>>
          <%= f.nome %>
        </option>
      <% }) %>
    </select>
  </label>

  <label>
    Empresa
    <input type="text" name="empresa" id="inpEmpresa" required readonly
      value="<%= plantao ? (plantao.EMPRESA || plantao.empresa || '') : '' %>">
  </label>

  <label>
    Centro de custo (setor)
    <select name="codCCusto" id="selSetor" required>
      <option value="">Selecione a filial primeiro</option>
      <% if (plantao && (plantao.CODCCUSTO || plantao.codCCusto)) { %>
        <option value="<%= plantao.CODCCUSTO || plantao.codCCusto %>" selected>
          <%= plantao.CODCCUSTO || plantao.codCCusto %>
        </option>
      <% } %>
    </select>
  </label>

  <label>
    Data
    <input type="date" name="data" required value="<%= dataVal %>">
  </label>

  <label>
    Hora início
    <input type="time" name="horaInicio" required value="<%= horaIniVal %>">
  </label>

  <label>
    Hora fim
    <input type="time" name="horaFim" required value="<%= horaFimVal %>">
  </label>

  <label>
    Tipo de plantão
    <select name="codTipoPlantao" id="selTipoPlantao" required>
      <option value="">Selecione filial e setor primeiro</option>
      <% if (plantao && (plantao.CODTIPOPLANTAO || plantao.codTipoPlantao)) { %>
        <option value="<%= plantao.CODTIPOPLANTAO || plantao.codTipoPlantao %>" selected>
          Tipo #<%= plantao.CODTIPOPLANTAO || plantao.codTipoPlantao %> (atual)
        </option>
      <% } %>
    </select>
  </label>

  <label>
    Médico escalado
    <select id="selMedico" required>
      <option value="">Selecione filial e tipo de plantão primeiro</option>
    </select>
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a href="/escala" class="btn">Cancelar</a>
  </div>
</form>

<script>
  const selFilial = document.getElementById("selFilial");
  const inpEmpresa = document.getElementById("inpEmpresa");
  const selSetor = document.getElementById("selSetor");
  const selTipoPlantao = document.getElementById("selTipoPlantao");
  const selMedico = document.getElementById("selMedico");
  const inpIdEspecialidade = document.getElementById("inpIdEspecialidade");
  const inpEspecialidade = document.getElementById("inpEspecialidade");
  const inpCrmEscalado = document.getElementById("inpCrmEscalado");
  const inpUfCrm = document.getElementById("inpUfCrm");

  const CRM_ATUAL = "<%= crmAtual %>";

  async function carregarEmpresa(codFilial) {
    if (!codFilial) { inpEmpresa.value = ""; return; }
    const res = await fetch(`/api/empresa/${codFilial}`);
    const data = await res.json();
    inpEmpresa.value = data.empresa || "";
  }

  async function carregarSetores(codFilial, setorSelecionadoAtual) {
    selSetor.innerHTML = '<option value="">Carregando...</option>';
    if (!codFilial) {
      selSetor.innerHTML = '<option value="">Selecione a filial primeiro</option>';
      return;
    }
    const res = await fetch(`/api/setores/${codFilial}`);
    const setores = await res.json();
    selSetor.innerHTML = '<option value="">Selecione o setor</option>' +
      setores.map(s => `<option value="${s.CODCCUSTO}" ${String(s.CODCCUSTO) === String(setorSelecionadoAtual) ? "selected" : ""}>${s.NOME}</option>`).join("");
  }

  async function carregarTiposPlantao(codFilial, codCCusto, tipoSelecionadoAtual) {
    selTipoPlantao.innerHTML = '<option value="">Carregando...</option>';
    if (!codFilial || !codCCusto) {
      selTipoPlantao.innerHTML = '<option value="">Selecione filial e setor primeiro</option>';
      return;
    }
    const res = await fetch(`/api/tipos-plantao?codFilial=${codFilial}&codCCusto=${encodeURIComponent(codCCusto)}`);
    const tipos = await res.json();
    selTipoPlantao.innerHTML = '<option value="">Selecione o tipo de plantão</option>' +
      tipos.map(t => {
        const esp = t.ESPECIALIDADE != null ? String(t.ESPECIALIDADE) : "";
        const selected = String(t.IDPRD) === String(tipoSelecionadoAtual) ? "selected" : "";
        return `<option value="${t.IDPRD}" data-especialidade="${esp.replace(/"/g, '&quot;')}" ${selected}>${t.DESCRICAO} (${t.TURNO}/${t.TIPO})</option>`;
      }).join("");

    if (tipoSelecionadoAtual) {
      const opt = selTipoPlantao.selectedOptions[0];
      if (opt && opt.dataset.especialidade) {
        aplicarEspecialidade(opt.dataset.especialidade);
      }
    }
  }

  function aplicarEspecialidade(especialidade) {
    inpEspecialidade.value = especialidade || "";
    const idNum = parseInt(especialidade, 10);
    inpIdEspecialidade.value = Number.isFinite(idNum) ? idNum : (especialidade || "");
  }

  async function carregarMedicos(codFilial, especialidade, crmSelecionado) {
    selMedico.innerHTML = '<option value="">Carregando...</option>';
    if (!codFilial || !especialidade) {
      selMedico.innerHTML = '<option value="">Selecione filial e tipo de plantão primeiro</option>';
      inpCrmEscalado.value = "";
      inpUfCrm.value = "";
      return;
    }
    const res = await fetch(`/api/medicos?codFilial=${codFilial}&especialidade=${encodeURIComponent(especialidade)}`);
    const medicos = await res.json();
    if (!medicos.length) {
      selMedico.innerHTML = '<option value="">Nenhum médico ativo para esta filial/especialidade</option>';
      inpCrmEscalado.value = "";
      inpUfCrm.value = "";
      return;
    }

    const alvo = (crmSelecionado || "").toUpperCase();
    selMedico.innerHTML = '<option value="">Selecione o médico</option>' +
      medicos.map(m => {
        const crmCompleto = `${m.crm}${m.ufCrm}`.toUpperCase();
        const selected = alvo && (crmCompleto === alvo || String(m.crm).toUpperCase() === alvo) ? "selected" : "";
        return `<option value="${m.crm}" data-uf="${m.ufCrm}" data-crm-completo="${m.crm}${m.ufCrm}" ${selected}>${m.nomeCompleto}</option>`;
      }).join("");

    sincronizarCrmOculto();
  }

  function sincronizarCrmOculto() {
    const opt = selMedico.selectedOptions[0];
    if (!opt || !opt.value) {
      inpCrmEscalado.value = "";
      inpUfCrm.value = "";
      return;
    }
    inpCrmEscalado.value = opt.dataset.crmCompleto || `${opt.value}${opt.dataset.uf || ""}`;
    inpUfCrm.value = opt.dataset.uf || "";
  }

  selFilial.addEventListener("change", () => {
    carregarEmpresa(selFilial.value);
    carregarSetores(selFilial.value, null);
    selTipoPlantao.innerHTML = '<option value="">Selecione filial e setor primeiro</option>';
    selMedico.innerHTML = '<option value="">Selecione filial e tipo de plantão primeiro</option>';
    inpCrmEscalado.value = "";
    inpUfCrm.value = "";
    aplicarEspecialidade("");
  });

  selSetor.addEventListener("change", () => {
    carregarTiposPlantao(selFilial.value, selSetor.value, null);
    selMedico.innerHTML = '<option value="">Selecione o tipo de plantão</option>';
    inpCrmEscalado.value = "";
    inpUfCrm.value = "";
    aplicarEspecialidade("");
  });

  selTipoPlantao.addEventListener("change", () => {
    const opt = selTipoPlantao.selectedOptions[0];
    const especialidade = opt ? (opt.dataset.especialidade || "") : "";
    aplicarEspecialidade(especialidade);
    carregarMedicos(selFilial.value, especialidade, null);
  });

  selMedico.addEventListener("change", sincronizarCrmOculto);

  // Edicao: pre-carrega setor, tipo e medico ja salvos
  const filialInicial = selFilial.value;
  const setorInicial = "<%= plantao ? (plantao.CODCCUSTO || plantao.codCCusto || '') : '' %>";
  const tipoInicial = "<%= plantao ? (plantao.CODTIPOPLANTAO || plantao.codTipoPlantao || '') : '' %>";
  const especialidadeInicial = "<%= especialidadeAtual %>";

  (async function initEdicao() {
    if (!filialInicial) return;
    await carregarSetores(filialInicial, setorInicial);
    await carregarTiposPlantao(filialInicial, setorInicial, tipoInicial);
    const esp = (selTipoPlantao.selectedOptions[0] && selTipoPlantao.selectedOptions[0].dataset.especialidade)
      || especialidadeInicial;
    aplicarEspecialidade(esp);
    await carregarMedicos(filialInicial, esp, CRM_ATUAL);
  })();
</script>
